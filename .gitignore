# Virtual environments
myenv/
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Client data and generated output never belong in version control
sources/
results/
feedback/
# Item catalogues sent by the client, read by Agent 3
catalogues/

# Credentials
.env
*.jsonl

# Derived state: caches are reproducible, registries are environment specific
cache/
lexicon/*_registry.json
# Keep the controlled vocabulary in git; only generated registries stay ignored.

# Synthetic test data and the results of testing against it, rebuilt on demand
.testruns/

# Model weights and the archives that carry them between machines. Gigabytes,
# fetched by fetch_models.py, and reproducible from the hub wherever it is
# reachable, so they are copied across by hand rather than committed.
*.tar.gz
.hf_bundle/
.hf_offline/
.hf_probe/
.hf_test_cache/

# Operating system noise
.DS_Store
Thumbs.db
po_join_data/