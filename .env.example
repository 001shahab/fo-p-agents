# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the values for your environment.
# ---------------------------------------------------------------------------

# Selects the language-model backend.
#   false -> direct OpenAI API (development / local testing)
#   true  -> Azure OpenAI via the PwC shared service (target deployment)
AZURE_ENABLE=false

# --- Azure OpenAI (used when AZURE_ENABLE=true) ----------------------------
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_BASE_URL="https://genai-sharedservice-emea.pwcinternal.com/v1/chat/completions"
AZURE_OPENAI_MODEL="azure.gpt-5.1"

# --- Direct OpenAI (used when AZURE_ENABLE=false) --------------------------
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.1"

# --- Optional tuning -------------------------------------------------------
LLM_BATCH_SIZE=20
LLM_TIMEOUT=60
