# ---------------------------------------------------------------------------
# Language-model configuration
#
# Copy this file to `.env` and fill in the values. `.env` is excluded from
# version control and must never be committed.
#
#   cp .env.example .env
#
# All four agents read this file. The language model is optional: every agent
# produces complete output with it switched off. When it is on, Agent 1 uses
# gpt-5.6-luna (low reasoning) to rewrite each line as an English sentence;
# the other agents use it for residue the local stack cannot resolve.
# ---------------------------------------------------------------------------

# Selects the backend. The two blocks below are read independently, so both can
# be populated at once and this switch decides which one is actually used.
#
#   false -> OpenAI directly          (local development and testing)
#   true  -> PwC GenAI shared service (deployment on the PwC estate)
AZURE_ENABLE=false


# --- OpenAI, direct (used when AZURE_ENABLE=false) -------------------------
# The base URL is deliberately NOT allowed to fall back to the shared-service
# URL below, so that a direct OpenAI key can never be transmitted to the
# shared-service endpoint by accident.
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.6-luna"


# --- PwC GenAI shared service (used when AZURE_ENABLE=true) ----------------
# The shared service is OpenAI-compatible. On this estate the gpt-5.6-luna
# deployment is named `openai.eu.gpt-5.6.luna`.
AZURE_OPENAI_API_KEY="sk-..."
AZURE_OPENAI_BASE_URL="https://genai-sharedservice-emea.pwcinternal.com/v1/chat/completions"
AZURE_OPENAI_MODEL="openai.eu.gpt-5.6.luna"


# --- Request tuning --------------------------------------------------------
# Phrases per request. Larger batches cost fewer tokens in prompt overhead but
# raise the cost of a single failed request, since the whole batch is retried.
LLM_BATCH_SIZE=25

# Seconds before a request is abandoned. gpt-5.6-luna with reasoning needs more
# headroom than a non-reasoning chat model.
LLM_TIMEOUT=120

# Reasoning depth for gpt-5.6-luna. `low` is the default for every agent.
LLM_REASONING_EFFORT=low

# Upper bound on requests per run. A safety net against an unexpected input
# distribution turning a cheap run into an expensive one; 0 disables the cap.
LLM_MAX_REQUESTS=0


# --- Spend control ---------------------------------------------------------
# Each agent keeps a running estimate of what the model tier has cost and stops
# at the figure below to ask whether to carry on. Agreeing raises the ceiling by
# the same amount again ($25 becomes $50, then $75), and each step needs its own
# answer; declining finishes the run on the local stack.
#
# This is the default offered at the prompt. It can be overridden per run with
# --llm-spend-limit, and 0 turns the alert off entirely.
LLM_SPEND_LIMIT=25.00

# Prices used to value the token counts, in dollars per million tokens. Change
# them when the published rates change or when the shared service quotes its
# own. Cached input is valued at the full input rate, so the estimate is an
# upper bound rather than an invoice.
LLM_INPUT_COST_PER_MTOK=1.25
LLM_OUTPUT_COST_PER_MTOK=10.00
